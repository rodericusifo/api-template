# more about time units: https://pkg.go.dev/time#ParseDuration

# SERVICES
SERVER_PORT=6060
AUTH_SERVICE_SERVER_HOST="auth_service"
AUTH_SERVICE_SERVER_PORT=4040
AUTHOR_SERVICE_SERVER_HOST="author_service"
AUTHOR_SERVICE_SERVER_PORT=5050
BOOK_SERVICE_SERVER_HOST="book_service"
BOOK_SERVICE_SERVER_PORT=7070

# DATABASE SQL
DATABASE_SQL_POSTGRES_ENABLED=false
DATABASE_SQL_POSTGRES_PRIMARY_DSN="" # Host: primary_postgres | Port: 5432
DATABASE_SQL_POSTGRES_PRIMARY_CONNECTION_TIMEOUT="20s"
DATABASE_SQL_POSTGRES_PRIMARY_MAX_IDLE_CONNECTION=5
DATABASE_SQL_POSTGRES_PRIMARY_MAX_OPEN_CONNECTION=10
DATABASE_SQL_POSTGRES_PRIMARY_DEBUG_MODE=false
DATABASE_SQL_POSTGRES_REPLICA_DSN="" # Host: replica_postgres | Port: 5432
DATABASE_SQL_POSTGRES_REPLICA_CONNECTION_TIMEOUT="20s"
DATABASE_SQL_POSTGRES_REPLICA_MAX_IDLE_CONNECTION=5
DATABASE_SQL_POSTGRES_REPLICA_MAX_OPEN_CONNECTION=10
DATABASE_SQL_POSTGRES_REPLICA_DEBUG_MODE=false

# DATABASE CACHE
DATABASE_CACHE_REDIS_ENABLED=false
DATABASE_CACHE_REDIS_PRIMARY_URL="" # Host: primary_redis | Port: 6379
DATABASE_CACHE_REDIS_REPLICA_URL="" # Host: replica_redis | Port: 6379
