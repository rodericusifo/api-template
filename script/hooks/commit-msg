#!/bin/bash

# Commit-msg hook for conventional commit validation
# This hook validates commit message format during interactive commits

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_error() {
    echo -e "${RED}ERROR: $1${NC}" >&2
}

print_success() {
    echo -e "${GREEN}SUCCESS: $1${NC}"
}

print_info() {
    echo -e "${BLUE}INFO: $1${NC}"
}

# Get commit message from the file
commit_msg_file="$1"
commit_msg=$(head -n 1 "$commit_msg_file")

# Check if this is a merge or revert commit by examining the git state
# Skip validation for merge commits
if [ -f .git/MERGE_HEAD ]; then
    print_info "Merge commit detected. Skipping pre-commit validation."
    exit 0
fi

# Skip validation for revert commits (check if REVERT_HEAD exists or commit message starts with "Revert")
if [ -f .git/REVERT_HEAD ]; then
    print_info "Revert commit detected. Skipping pre-commit validation."
    exit 0
fi

# Validate conventional commit format
# Pattern: type(scope): description
# Examples: feat(service-a): add new feature, fix(auth): resolve login issue
if echo "$commit_msg" | grep -Eq '^(build|chore|ci|docs|feat|fix|perf|refactor|revert|style|test)\([a-zA-Z0-9_-]+\):( [^[:space:]]+)? .+'; then
    print_success "Conventional commit format validation passed: $commit_msg"
else
    print_error "Commit message does not follow conventional format."
    print_error "Current message: $commit_msg"
    print_error ""
    print_error "Expected format: type(scope): description"
    print_error "Types: build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test"
    print_error "Examples:"
    print_error "  feat(service-a): add new authentication feature"
    print_error "  fix(auth): resolve login validation issue"
    print_error "  docs(api-gateway): update API documentation"
    exit 1
fi

exit 0
