#!/bin/bash

# Pre-commit hook for single service per commit
# This hook ensures only one service is modified per commit

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Function to print colored output
print_error() {
    echo -e "${RED}ERROR: $1${NC}" >&2
}

print_success() {
    echo -e "${GREEN}SUCCESS: $1${NC}"
}

print_warning() {
    echo -e "${YELLOW}WARNING: $1${NC}"
}

print_info() {
    echo -e "${BLUE}INFO: $1${NC}"
}

print_info "Running pre-commit hook for conventional commit and single service validation..."

# Check if this is a merge or revert commit by examining the git state
# Skip validation for merge commits
if [ -f .git/MERGE_HEAD ]; then
    print_info "Merge commit detected. Skipping pre-commit validation."
    exit 0
fi

# Skip validation for revert commits (check if REVERT_HEAD exists or commit message starts with "Revert")
if [ -f .git/REVERT_HEAD ]; then
    print_info "Revert commit detected. Skipping pre-commit validation."
    exit 0
fi

# Get staged files
staged_files=$(git diff --cached --name-only)

if [ -z "$staged_files" ]; then
    print_info "No files staged for commit."
    exit 0
fi

# Check for application files
application_files_modified=false
changed_services=()

while IFS= read -r file; do
    if [[ $file == application/* ]]; then
        application_files_modified=true
        service_name=$(echo $file | cut -d'/' -f2)
        if [[ ! " ${changed_services[@]} " =~ " ${service_name} " ]]; then
            changed_services+=("$service_name")
        fi
    fi
done <<< "$staged_files"

# If no application changes, skip service validation
if [ "$application_files_modified" = false ]; then
    print_info "No application files modified. Skipping service validation."
else
    # CASE 2: Only one service allowed per commit
    if [ ${#changed_services[@]} -gt 1 ]; then
        print_error "Multiple services modified in this commit: ${changed_services[*]}"
        print_error "Only one service allowed per commit."
        print_error ""
        print_error "This helps maintain:"
        print_error "  • Clear version history per service"
        print_error "  • Easier rollbacks and debugging"
        print_error "  • Independent service deployments"
        print_error "  • Better code review process"
        exit 1
    fi
    
    print_success "Single service validation passed: ${changed_services[0]}"
fi

print_success "Pre-commit validation completed successfully!"
exit 0